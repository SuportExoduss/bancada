  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.2",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "emuladores": "firebase emulators:start",
    "testar:regras": "firebase emulators:exec --only firestore \"node testes/rules.test.mjs\"",
    "testar:conta": "firebase emulators:exec --only auth,firestore \"node testes/conta.test.mjs\"",
    "testar": "npm run testar:regras && npm run testar:conta && npm run testar:seguir",
    "testar:seguir": "firebase emulators:exec --only auth,firestore \"node testes/seguir.test.mjs\""
  },
